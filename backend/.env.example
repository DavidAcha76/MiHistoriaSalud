NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
CORS_ORIGIN=*

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mihistoria_salud
DB_CONNECTION_LIMIT=10

JWT_ACCESS_SECRET=cambia-esta-clave-access-por-una-muy-larga
JWT_REFRESH_SECRET=cambia-esta-clave-refresh-por-una-muy-larga
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=180

# local | s3
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage/private
MAX_FILE_MB=10

# S3 / almacenamiento compatible con S3 (solo si STORAGE_DRIVER=s3)
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# DeepSeek. En modo demo NO se llama a un proveedor externo.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_MOCK_MODE=true

# Semilla académica con datos ficticios
SEED_DEMO=true
DEMO_EMAIL=demo@mihistoria.local
DEMO_PASSWORD=Demo1234!
