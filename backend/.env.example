# Plantilla de configuración del backend de Clinia. Copia este archivo como .env
# (o .env.production) y reemplaza los valores. Nunca subas los archivos reales al repositorio.

NODE_ENV=development
PORT=4000
# En producción: 1 si la API está detrás de IIS u otro proxy inverso.
TRUST_PROXY=0
# URL pública de la API (HTTPS obligatorio en producción).
APP_BASE_URL=http://localhost:4000
# Orígenes permitidos separados por comas. En producción: https://www.clinia.win,https://clinia.win
CORS_ORIGIN=*
# URL de la web; se usa en el enlace de recuperación de contraseña.
WEB_APP_URL=http://localhost:8081

# Base de datos MySQL 8.0+ o MariaDB 10.11+.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=usuario
DB_PASSWORD="cambia-esta-contraseña"
DB_NAME=mihistoria_salud
DB_CONNECTION_LIMIT=10
# disabled | preferred | required | verify_identity
DB_SSL_MODE=disabled

# Secretos distintos de al menos 32 caracteres (por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))").
JWT_ACCESS_SECRET=reemplaza-por-un-secreto-largo-y-aleatorio
JWT_REFRESH_SECRET=reemplaza-por-otro-secreto-largo-y-aleatorio
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=180

# Documentos clínicos: database | local | s3 (almacenamiento privado de objetos).
STORAGE_DRIVER=database
LOCAL_STORAGE_DIR=./storage/private
MAX_FILE_MB=10
S3_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Correo para recuperar el acceso: log (solo desarrollo) | resend | disabled.
MAIL_DRIVER=log
MAIL_FROM="Clinia <no-responder@clinia.win>"
MAIL_API_KEY=
MAIL_API_URL=https://api.resend.com/emails

# Protección de credenciales.
MAX_FAILED_LOGINS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_MINUTES=30

# Inteligencia artificial (DeepSeek). Con AI_MOCK_MODE=true se usan respuestas deterministas de prueba.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
AI_MOCK_MODE=false

# Datos de demostración: siempre false en producción.
SEED_DEMO=false
DEMO_EMAIL=demo@mihistoria.local
DEMO_PASSWORD=Demo1234!
