{
  "info": {
    "name": "MiHistoria Salud API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api" },
    { "key": "accessToken", "value": "" },
    { "key": "profileId", "value": "" },
    { "key": "eventId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login demo",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"demo@mihistoria.local\",\n  \"password\": \"Demo1234!\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Perfiles",
      "item": [
        {
          "name": "Listar perfiles",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/profiles", "host": ["{{baseUrl}}"], "path": ["profiles"] }
          }
        }
      ]
    },
    {
      "name": "Historial",
      "item": [
        {
          "name": "Línea de tiempo",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/profiles/{{profileId}}/events?pageSize=20", "host": ["{{baseUrl}}"], "path": ["profiles", "{{profileId}}", "events"], "query": [{ "key": "pageSize", "value": "20" }] }
          }
        },
        {
          "name": "Crear consulta",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"eventType\": \"CONSULTATION\",\n  \"title\": \"Consulta de prueba\",\n  \"eventDate\": \"2026-08-28\",\n  \"description\": \"Dato sintético\",\n  \"source\": \"Centro Demo\",\n  \"details\": {\n    \"professional_name\": \"Profesional Demo\",\n    \"specialty\": \"Especialidad Demo\",\n    \"facility\": \"Centro Demo\",\n    \"reason\": \"Prueba académica\"\n  }\n}" },
            "url": { "raw": "{{baseUrl}}/profiles/{{profileId}}/events", "host": ["{{baseUrl}}"], "path": ["profiles", "{{profileId}}", "events"] }
          }
        }
      ]
    },
    {
      "name": "IA",
      "item": [
        {
          "name": "Analizar registros seleccionados",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"eventIds\": [\"{{eventId}}\"],\n  \"purpose\": \"Revisión informativa\"\n}" },
            "url": { "raw": "{{baseUrl}}/profiles/{{profileId}}/ai/analyze", "host": ["{{baseUrl}}"], "path": ["profiles", "{{profileId}}", "ai", "analyze"] }
          }
        }
      ]
    }
  ]
}
