{
  "expo": {
    "name": "Clinia",
    "slug": "mihistoria-salud",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "icon": "./assets/brand/clinia-logo.png",
    "splash": {
      "image": "./assets/brand/clinia-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C1B24"
    },
    "android": {
      "package": "com.hermesoft.mihistoriasalud",
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/clinia-logo.png",
        "backgroundColor": "#0C1B24"
      }
    },
    "ios": {
      "bundleIdentifier": "com.hermesoft.mihistoriasalud",
      "supportsTablet": true
    },
    "plugins": [
      "expo-secure-store",
      "expo-document-picker"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/brand/clinia-logo.png"
    }
  }
}
