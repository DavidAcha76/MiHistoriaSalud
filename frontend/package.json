{
  "name": "mihistoria-salud-app",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "node scripts/expo-env.cjs local start --go --lan --port 8081",
    "android": "node scripts/expo-env.cjs local start --go --lan --port 8081 --android",
    "ios": "node scripts/expo-env.cjs local start --go --lan --port 8081 --ios",
    "web": "node scripts/expo-env.cjs local start --go --lan --port 8081 --web",
    "start:dev-client": "node scripts/expo-env.cjs local start --dev-client --lan --port 8081",
    "start:published": "node scripts/expo-env.cjs published start --go --lan --port 8081 --clear",
    "web:published": "node scripts/expo-env.cjs published start --go --lan --port 8081 --web --clear",
    "build:web": "node scripts/expo-env.cjs build export --platform web --output-dir dist --clear && node scripts/prepare-web-assets.cjs",
    "check:native": "node scripts/expo-env.cjs build export --platform android --platform ios --output-dir dist-native",
    "doctor": "npx expo-doctor",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "0.4.2",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "7.18.17",
    "@react-navigation/native": "7.3.18",
    "@react-navigation/native-stack": "7.18.10",
    "expo": "~57.0.23",
    "expo-build-properties": "~57.0.15",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.16",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.20",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "~6.0.3"
  }
}
