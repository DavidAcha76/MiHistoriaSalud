<mxfile host="app.diagrams.net"><diagram id="arbol" name="Árbol de problemas"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="617" pageHeight="422"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n3" value="EFECTOS" style="text;html=1;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#C0504D;" vertex="1" parent="1"><mxGeometry x="9" y="9" width="120" height="24" as="geometry"/></mxCell><mxCell id="n4" value="CAUSAS" style="text;html=1;fontFamily=Arial;fontSize=14;fontStyle=1;fontColor=#4472C4;" vertex="1" parent="1"><mxGeometry x="9" y="260" width="120" height="24" as="geometry"/></mxCell><mxCell id="n5" value="PROBLEMA CENTRAL: Información médica personal fragmentada y dispersa, sin un historial de salud continuo, organizado y accesible para el usuario" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=1.5;fontFamily=Arial;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="9" y="177" width="579" height="66" as="geometry"/></mxCell><mxCell id="n6" value="Demora para reconstruir el historial en una nueva consulta médica" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C0504D;strokeWidth=1.5;fontFamily=Arial;fontSize=13;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="9" y="37" width="136" height="94" as="geometry"/></mxCell><mxCell id="n7" style="endArrow=block;html=1;strokeColor=#5A626E;strokeWidth=1.5;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n8" value="Omisión, duplicación o pérdida de antecedentes y documentos clínicos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#C0504D;strokeWidth=1.5;fontFamily=Arial;fontSize=13;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="156" y="37" width="136" height="94" as="geometry"/></mxCell><mxCell id="n9" style="endArrow=block;html=1;strokeColor=#5A626E;strokeWidth=1.5;" edge="1" parent="1" source="n5" target